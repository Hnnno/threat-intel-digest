# --- APIs de Threat Intelligence ---
VIRUSTOTAL_API_KEY=tu_api_key_aqui
ABUSEIPDB_API_KEY=tu_api_key_aqui

# --- LLM (Claude via Anthropic) ---
ANTHROPIC_API_KEY=tu_api_key_aqui

# --- Notificador Email ---
# Si usas Gmail, genera una "contrasena de aplicacion" en tu cuenta Google
EMAIL_SENDER=tu_email@gmail.com
EMAIL_PASSWORD=tu_contrasena_de_aplicacion
EMAIL_RECIPIENT=destino@email.com

# --- Notificador Telegram ---
# Crea un bot con @BotFather y obtene el token
# El chat_id lo obtienes hablando con @userinfobot
TELEGRAM_BOT_TOKEN=tu_bot_token_aqui
TELEGRAM_CHAT_ID=tu_chat_id_aqui

# --- Scheduler ---
# Hora en formato HH:MM para el envio diario del reporte
SCHEDULE_TIME=08:00

# --- Notificadores activos (email, telegram, ambos) ---
NOTIFIER=telegram
